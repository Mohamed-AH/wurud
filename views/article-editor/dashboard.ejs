<%- include('layout', { body: `
<header class="editor-header">
  <h1>لوحة تحرير المقالات</h1>
  <div class="header-actions">
    <div class="user-info">
      ${user.profilePhoto ? `<img src="${user.profilePhoto}" alt="" class="user-avatar">` : ''}
      <span>${user.displayName || user.email}</span>
    </div>
    <a href="/article-editor/logout" class="btn btn-secondary">خروج</a>
  </div>
</header>

<main class="editor-main">
  <!-- Filter Tabs -->
  <div class="filter-tabs">
    <a href="/article-editor?filter=all${search ? '&search=' + encodeURIComponent(search) : ''}"
       class="filter-tab ${!filter || filter === 'all' ? 'active' : ''}">
      الكل (${stats.total})
    </a>
    <a href="/article-editor?filter=not-edited${search ? '&search=' + encodeURIComponent(search) : ''}"
       class="filter-tab ${filter === 'not-edited' ? 'active' : ''}">
      لم يُحرر (${stats.notEdited})
    </a>
    <a href="/article-editor?filter=edited${search ? '&search=' + encodeURIComponent(search) : ''}"
       class="filter-tab ${filter === 'edited' ? 'active' : ''}">
      تم التحرير (${stats.edited})
    </a>
  </div>

  <form class="search-box" method="GET" action="/article-editor">
    <input type="hidden" name="filter" value="${filter || 'all'}">
    <input
      type="search"
      name="search"
      class="search-input"
      placeholder="ابحث في المقالات..."
      value="${search || ''}"
    >
    <button type="submit" class="btn btn-primary">بحث</button>
    ${search ? `<a href="/article-editor?filter=${filter || 'all'}" class="btn btn-outline">مسح</a>` : ''}
  </form>

  <div class="card">
    <div class="card-header">
      <span class="card-title">المقالات (${pagination.totalCount})</span>
    </div>

    ${articles.length > 0 ? `
      <div class="article-list">
        ${articles.map(article => `
          <a href="/article-editor/article/${article.shortId || article._id}" class="article-item">
            <div class="article-number">#${article.shortId}</div>
            <div class="article-content">
              <div class="article-title">${article.title}</div>
              <div class="article-meta">
                <span class="article-type">${article.type === 'Asdaa' ? 'أصداء' : 'تليجرام'}</span>
                <span>${new Date(article.publishedAt).toLocaleDateString('ar-SA')}</span>
              </div>
            </div>
            <div class="article-status">
              ${article.lastEditedAt ? `
                <span class="status-badge edited">تم التحرير</span>
                <span class="edited-info">${article.lastEditedBy?.displayName || 'محرر'} - ${timeAgo(new Date(article.lastEditedAt))}</span>
              ` : `
                <span class="status-badge not-edited">لم يُحرر</span>
              `}
            </div>
          </a>
        `).join('')}
      </div>

      ${pagination.totalPages > 1 ? `
        <nav class="pagination">
          ${pagination.hasPrev ? `
            <a href="/article-editor?page=${pagination.page - 1}&filter=${filter || 'all'}${search ? '&search=' + encodeURIComponent(search) : ''}" class="page-link">
              ←
            </a>
          ` : ''}

          ${Array.from({length: Math.min(5, pagination.totalPages)}, (_, i) => {
            let pageNum;
            if (pagination.totalPages <= 5) {
              pageNum = i + 1;
            } else if (pagination.page <= 3) {
              pageNum = i + 1;
            } else if (pagination.page >= pagination.totalPages - 2) {
              pageNum = pagination.totalPages - 4 + i;
            } else {
              pageNum = pagination.page - 2 + i;
            }
            return `
              <a href="/article-editor?page=${pageNum}&filter=${filter || 'all'}${search ? '&search=' + encodeURIComponent(search) : ''}"
                 class="page-link ${pageNum === pagination.page ? 'active' : ''}">
                ${pageNum}
              </a>
            `;
          }).join('')}

          ${pagination.hasNext ? `
            <a href="/article-editor?page=${pagination.page + 1}&filter=${filter || 'all'}${search ? '&search=' + encodeURIComponent(search) : ''}" class="page-link">
              →
            </a>
          ` : ''}
        </nav>
      ` : ''}
    ` : `
      <div class="empty-state">
        <div class="empty-state-icon">📄</div>
        <p>${search ? 'لا توجد نتائج للبحث' : 'لا توجد مقالات'}</p>
      </div>
    `}
  </div>
</main>

<style>
  .filter-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .filter-tab {
    padding: 8px 16px;
    background: var(--card-bg);
    border: 1px solid var(--border-gold);
    border-radius: 20px;
    color: var(--text-mid);
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    transition: all 0.2s;
  }

  .filter-tab:hover {
    background: var(--gold-light);
  }

  .filter-tab.active {
    background: var(--gold-primary);
    color: white;
    border-color: var(--gold-primary);
  }

  .article-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: var(--card-bg);
    border: 1px solid var(--border-gold);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
  }

  .article-item:hover {
    border-color: var(--gold-primary);
    transform: translateY(-1px);
  }

  .article-number {
    min-width: 50px;
    padding: 8px 0;
    text-align: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--gold-primary);
    background: var(--gold-light);
    border-radius: 6px;
  }

  .article-content {
    flex: 1;
    min-width: 0;
  }

  .article-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .article-meta {
    display: flex;
    gap: 10px;
    font-size: 11px;
    color: var(--text-muted);
  }

  .article-status {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    min-width: 90px;
  }

  .status-badge {
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 600;
  }

  .status-badge.edited {
    background: #D4EDDA;
    color: #155724;
  }

  .status-badge.not-edited {
    background: #E9ECEF;
    color: #6C757D;
  }

  .edited-info {
    font-size: 10px;
    color: var(--text-muted);
    text-align: left;
  }

  @media (max-width: 600px) {
    .article-item {
      flex-wrap: wrap;
    }

    .article-number {
      min-width: 45px;
      font-size: 12px;
    }

    .article-content {
      flex: 1 1 calc(100% - 60px);
    }

    .article-status {
      width: 100%;
      flex-direction: row;
      justify-content: flex-start;
      align-items: center;
      margin-top: 8px;
      padding-top: 8px;
      border-top: 1px solid var(--border-gold);
    }

    .edited-info {
      text-align: right;
    }
  }
</style>

<script>
  function timeAgo(date) {
    const seconds = Math.floor((new Date() - date) / 1000);

    if (seconds < 60) return 'الآن';
    if (seconds < 3600) return Math.floor(seconds / 60) + ' د';
    if (seconds < 86400) return Math.floor(seconds / 3600) + ' س';
    if (seconds < 604800) return Math.floor(seconds / 86400) + ' ي';
    return date.toLocaleDateString('ar-SA');
  }
</script>
` }) %>
