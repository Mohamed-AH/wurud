<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>تسجيل الدخول - محرر المقالات</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Cairo', sans-serif;
      background: linear-gradient(135deg, #2C1508 0%, #5A6944 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .login-card {
      background: #FDF8F2;
      border-radius: 16px;
      padding: 40px;
      width: 100%;
      max-width: 400px;
      text-align: center;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }

    .login-icon {
      font-size: 48px;
      margin-bottom: 16px;
    }

    .login-title {
      font-size: 24px;
      font-weight: 700;
      color: #2C1508;
      margin-bottom: 8px;
    }

    .login-subtitle {
      font-size: 14px;
      color: #7A5C3A;
      margin-bottom: 32px;
    }

    .google-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      width: 100%;
      padding: 14px 24px;
      background: white;
      border: 2px solid #DEC99A;
      border-radius: 10px;
      font-family: inherit;
      font-size: 16px;
      font-weight: 600;
      color: #2C1508;
      cursor: pointer;
      transition: all 0.2s;
      text-decoration: none;
    }

    .google-btn:hover {
      background: #C49A3C;
      border-color: #C49A3C;
      color: white;
    }

    .google-btn svg {
      width: 20px;
      height: 20px;
    }

    .error-message {
      margin-top: 20px;
      padding: 12px;
      background: #FFEBEE;
      color: #C62828;
      border-radius: 8px;
      font-size: 14px;
    }

    .back-link {
      display: inline-block;
      margin-top: 24px;
      color: #7A5C3A;
      text-decoration: none;
      font-size: 14px;
    }

    .back-link:hover {
      color: #C49A3C;
    }
  </style>
</head>
<body>
  <div class="login-card">
    <div class="login-icon">📝</div>
    <h1 class="login-title">محرر المقالات</h1>
    <p class="login-subtitle">سجّل دخولك لتحرير المقالات وإصلاح الأخطاء</p>

    <a href="/auth/google?returnTo=/article-editor" class="google-btn">
      <svg viewBox="0 0 24 24">
        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
      </svg>
      تسجيل الدخول بحساب Google
    </a>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-message">
        <% if (error === 'inactive') { %>
          حسابك غير مفعّل. يرجى التواصل مع المسؤول.
        <% } else { %>
          حدث خطأ في تسجيل الدخول. حاول مرة أخرى.
        <% } %>
      </div>
    <% } %>

    <a href="/" class="back-link">← العودة للموقع</a>
  </div>
</body>
</html>
